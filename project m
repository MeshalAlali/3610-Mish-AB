function follow_wall()
    nb = get_nb();


    Kp = 0.004;  % |err| max ~1 -> |control| max ~2
    Ki = 0.000008;
    Kd = 0.006; % D term blows up on noisy ultrasonic + tiny dt

        vals = nb.reflectanceRead();
    
        % change from a struct to a list for convenience
        vals = [vals.one, vals.two, vals.three, vals.four, vals.five, vals.six];
        


    integral = 0; % i state
    prevError = 0; % last error
    prevTime = 0; % last time

    skipFrontS = 1;

    sawAllWhite = false; % state flag

    sideTarget = 250; % wall target (raw units, ~7.5 cm)
    cylinderDetect = 450; % cylinder detect distance (left sensor)

    % DRIVE TO CYLINDER
    % if (skipFrontS)
    %     while nb.ultrasonicRead1() >= 550
    %         drive(9, 9.85);
    %         pause(0.01)
    %     end
    %     skipFrontS = 0
    % end

    
    follow_line(1)
    stop_driving()
    pause(0.10); % settle

    % TURN RIGHT
    %turn90();
    turn90();
    pause(0.10); % settle

    drive(9, 9, 0.03); % wake motors

    % WALL LOOP - PID on side distance, drives both motors
     baseSpeed = 9;
     tic
     pause(0.03); % avoid tiny dt
     while toc < 60 % runtime cap
    
        % change from a struct to a list for convenience
        vals = nb.reflectanceRead();
        vals = [vals.one, vals.two, vals.three, vals.four, vals.five, vals.six];
          if (some_black(vals))
              break
          end

          dt = toc - prevTime;
          prevTime = toc;

          if dt <= 0
              continue
          end

          sideDistanceRaw = clip(nb.ultrasonicRead2(),0,800);

          error = (sideTarget - sideDistanceRaw); % + = too close, - = too far

          integral = integral + error * dt;
          derivative = (error - prevError) / dt;
          control = Kp * error + Ki * integral + Kd * derivative;% clamp
          prevError = error;

          % STEERING (wall on left: +control = turn toward wall)
          left = baseSpeed + control*0.9
          right = baseSpeed - (control*1.1)

          drive(left, right);
     end
     drive(0, 0);
end



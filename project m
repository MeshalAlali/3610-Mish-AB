%% -------- Drive Until All White -------- %%

function drive_until_white()
    nb = get_nb();

    while true
        vals = nb.reflectanceRead();
        vals = [vals.one, vals.two, vals.three, vals.four, vals.five, vals.six];

        % keep driving straight
        drive(9, 9);

        % stop condition
        if all_white(vals)
            break
        end
    end

    drive(0, 0); % stop motors
end


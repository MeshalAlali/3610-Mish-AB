% ------------------ Motor Drive ------------------- %
function drive(leftSpeed, rightSpeed, duration)
    nb = get_nb();

    % wires flipped: motor 1 is physical right, motor 2 is physical left
    if nargin < 3
        nb.setMotor(1, rightSpeed);
        nb.setMotor(2, leftSpeed);
    else
        nb.setMotor(1, rightSpeed);
        nb.setMotor(2, leftSpeed);
        pause(duration);
        nb.setMotor(1, 0);
        nb.setMotor(2, 0);
    end
end




